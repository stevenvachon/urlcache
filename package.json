{
  "name": "urlcache",
  "description": "Normalized URL key-value cache.",
  "version": "1.0.0-rc",
  "license": "MIT",
  "author": "Steven Vachon <contact@svachon.com> (https://svachon.com)",
  "repository": "github:stevenvachon/urlcache",
  "type": "module",
  "exports": "./index.js",
  "dependencies": {
    "deep-freeze-strict": "^1.1.1",
    "minurl": "1.0.0-alpha16"
  },
  "devDependencies": {
    "@types/deep-freeze-strict": "^1.1.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "npm run build:spellcheck && npm run build:lint && npm run build:typecheck:supplemental && npm run build:compile",
    "build:compile": "tsc -p tsconfig.build.json",
    "build:lint": "prettier --check '*.{config.js,json,md,ts}' '!*.d.ts'",
    "build:spellcheck": "cspell '*.{config.js,json,md,ts}' '!*.d.ts' --no-progress",
    "build:typecheck:supplemental": "tsc --project tsconfig.check.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run test:watch -- --reporter=verbose --run",
    "test:watch": "vitest dev --coverage --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=text"
  },
  "files": [
    "index.d.ts",
    "index.d.ts.map",
    "index.js",
    "index.js.map"
  ],
  "keywords": [
    "cache",
    "uri",
    "url",
    "whatwg"
  ]
}
